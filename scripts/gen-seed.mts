// Generates supabase/seed.sql from the FAKE fixtures in src/lib/demo/fixtures.ts.
// Usage: node scripts/gen-seed.mts > supabase/seed.sql
import * as f from "../src/lib/demo/fixtures.ts";

const q = (v: unknown): string => {
  if (v === null || v === undefined) return "null";
  if (typeof v === "number") return String(v);
  if (typeof v === "boolean") return v ? "true" : "false";
  if (Array.isArray(v)) return `array[${v.map(q).join(",")}]::uuid[]`;
  return `'${String(v).replace(/'/g, "''")}'`;
};
const insert = (table: string, rows: Record<string, unknown>[]) => {
  if (!rows.length) return "";
  const cols = Object.keys(rows[0]);
  return `insert into public.${table} (${cols.join(", ")}) values\n` +
    rows.map((r) => `  (${cols.map((c) => q(r[c])).join(", ")})`).join(",\n") + ";\n\n";
};
const pick = <T extends object>(o: T, ...keys: (keyof T)[]) =>
  Object.fromEntries(keys.map((k) => [k, o[k]])) as Record<string, unknown>;

let out = `-- GENERATED by scripts/gen-seed.mts from src/lib/demo/fixtures.ts — FAKE DATA ONLY.
-- Dates are relative to the day it was generated. Do not hand-edit.
begin;
`;
out += insert("urgent_questions", f.urgentQuestions.map((x) => pick(x, "id", "question", "topic", "asked_of", "owner_name", "priority", "status", "answer", "answered_by", "answered_at", "due_on", "sort_order", "source")));
out += insert("calendar_events", f.calendarEvents.map((x) => pick(x, "id", "section", "title", "kind", "about", "starts_at", "all_day", "location", "driver", "notes", "source")));
out += insert("legal_documents", f.legalDocuments.map((x) => pick(x, "id", "doc_type", "title", "principal", "status", "needs_recording", "prepared_by", "drafted_on", "signed_on", "recorded_on", "original_location", "open_issue", "notes", "sort_order", "source")));
out += insert("contact_groups", f.contactGroups.map((x) => pick(x, "id", "name", "kind", "description")));
out += insert("people", f.people.map((x) => pick(x, "id", "full_name", "relationship", "connected_to", "email", "phone", "city", "region", "closeness", "last_contact_on", "preferred_method", "notify_first", "confirmed", "notes")));
out += insert("person_groups", f.people.flatMap((p) => p.group_ids.map((g) => ({ person_id: p.id, group_id: g }))));
out += insert("notification_lists", f.notificationLists.map((x) => pick(x, "id", "name", "purpose", "description")));
out += insert("notification_list_members", f.notificationLists.flatMap((l) => l.members.map((m) => ({ list_id: l.id, person_id: m.person_id, wave: m.wave }))));
out += insert("notification_campaigns", f.notificationCampaigns.map((x) => ({ id: x.id, list_id: x.list_id, title: x.title, message: x.message, status: "draft" })));
out += insert("notification_recipients", f.notificationCampaigns.flatMap((c) => c.recipients.map((r) => ({ campaign_id: c.id, person_id: r.person_id, status: r.status, contacted_by: r.contacted_by, note: r.note }))));
out += insert("bills", f.bills.map((x) => pick(x, "id", "payee", "category", "amount", "frequency", "next_due_on", "autopay", "status", "notes", "source")));
out += insert("lab_results", f.labResults.map((x) => pick(x, "id", "patient", "test_name", "value", "unit", "ref_low", "ref_high", "taken_on", "source")));
out += insert("final_wishes", f.finalWishes.map((x) => pick(x, "id", "person", "topic", "wish", "confirmed")));
out += insert("loans", f.loans.map((x) => pick(x, "id", "direction", "counterparty", "principal", "rate_pct", "status", "note_signed")));
out += insert("riana_updates", f.rianaUpdates.map((x) => ({ ...pick(x, "id", "kind", "summary", "received_at", "review_status"), payload: "{}" })));
out += "commit;\n";
process.stdout.write(out);
