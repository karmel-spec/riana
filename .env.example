# --- Real deployment -------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SITE_URL=https://binder.example.com
# Server-only (never NEXT_PUBLIC_): lets super admins set passwords from People & Access.
# SUPABASE_SERVICE_ROLE_KEY=...
# Google Drive import (server-only): the service account's JSON key, raw or base64.
# GOOGLE_SERVICE_ACCOUNT_JSON=...
# Or, when the Google Cloud project forbids service-account keys, a Google sign-in (see docs/DRIVE_IMPORT.md):
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...   (issued once by Admin → Drive import → Connect Google Drive)
# GOOGLE_OAUTH_ACCOUNT=the-family-google-account@gmail.com
# Ask Riana chat (server-only, never NEXT_PUBLIC_): the webhook that wakes Riana's routine. See docs/ASK_RIANA.md.
# Copy both from the routine panel into Netlify. Unset = messages are stored and wait for Riana's catch-up poll.
# RIANA_WEBHOOK_URL=https://example.invalid/your-routine-webhook
# RIANA_WEBHOOK_KEY=...

# --- Local preview with fake data (never set this in production) ------------
GREENE_DEMO=1
